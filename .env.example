# ─────────────────────────────────────────────────────────────
#  CrowdWisdom Video Ads Agent — environment
#  Copy to .env and fill in.  Every key below has a free tier.
# ─────────────────────────────────────────────────────────────

# LLM provider (required for live runs) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model for every agent. Precedence: an explicit per-agent model in
# config/pipeline.yaml > this variable > pipeline.yaml defaults.model.
# OpenRouter reserves credit against max_tokens, so a paid model needs a funded
# balance even for short replies. On a zero-balance account use a free model:
#   CWT_MODEL=nvidia/nemotron-3.5-lightning:free
CWT_MODEL=anthropic/claude-sonnet-4.6
# Optional alternative provider — https://build.nvidia.com
NVIDIA_API_KEY=

# Ad mining — https://console.apify.com/settings/integrations
APIFY_TOKEN=
APIFY_ADS_ACTOR=apify/facebook-ads-scraper

# Research — https://app.tavily.com  (free 1k credits/mo)
TAVILY_API_KEY=
# Research — https://dashboard.exa.ai  (free tier)
EXA_API_KEY=

# ── Video generation (all optional; the renderer degrades gracefully) ────────
# Path to a local clone of https://github.com/calesthio/OpenMontage
OPENMONTAGE_HOME=
# Optional creative providers consumed by OpenMontage itself
ELEVENLABS_API_KEY=
FAL_KEY=
PEXELS_API_KEY=

# ── Behaviour ───────────────────────────────────────────────────────────────
# Use the Hermes AIAgent runtime instead of raw OpenRouter calls (recommended).
CWT_USE_HERMES=1
# Hard wall-clock limit per LLM call, seconds. requests' own timeout is per
# socket read, so a throttled free tier can otherwise trickle bytes forever.
CWT_LLM_DEADLINE=240
# Path to a local clone of https://github.com/NousResearch/hermes-agent
HERMES_HOME=
